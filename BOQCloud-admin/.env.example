# AWS Cognito Configuration
# Copy this file to .env.local and fill in your AWS values

# AWS Region (e.g., us-east-1, eu-west-1)
REACT_APP_AWS_REGION=us-east-1

# Cognito User Pool ID
# Found in: AWS Console > Cognito > User Pools > Your Pool > Pool ID
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID
# Found in: AWS Console > Cognito > User Pools > Your Pool > App Integration > App Client ID
REACT_APP_COGNITO_CLIENT_ID=nbfkhi1a7avg29joscr05f3q6

# Optional: Cognito Domain (for OAuth flows)
# REACT_APP_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
